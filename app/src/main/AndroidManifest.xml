        <activity
            android:name=".ui.booking.BookingCompleteAct"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.LUDIAN" />


        <activity
            android:name=".ui.booking.PropertyDetailAct"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.LUDIAN" />


        <activity
            android:name=".ui.calender.CalendarAct"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.LUDIAN" />

        <activity
            android:name=".ui.booking.BookingPaymentAct"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.LUDIAN" />


