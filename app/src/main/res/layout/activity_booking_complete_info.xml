                    <TextView
                        android:id="@+id/tvReservationNoOfNights"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:gravity="end"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_toEndOf="@+id/tvReservationNoOfNightsTitle"
                        android:text="Saturday,February 24,2024"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/color_gray_light3"
                        android:textSize="@dimen/_10sdp"
                        />



                </RelativeLayout>



            </LinearLayout>

            <LinearLayout
