<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

   <androidx.core.widget.NestedScrollView
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:scrollbars="none"
       android:background="@color/white">

       <RelativeLayout
           android:layout_width="match_parent"
           android:layout_height="match_parent"
           android:orientation="vertical"
           android:background="@color/white">


           <ImageView
                   android:id="@+id/ivHeader"
                   android:layout_width="match_parent"
                   android:layout_height="@dimen/_100sdp"
                   android:src="@drawable/img_home_header"
                   android:scaleType="fitXY"/>


           <RelativeLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_margin="@dimen/_20sdp">

               <de.hdodenhof.circleimageview.CircleImageView
                   android:id="@+id/ivUserImg"
                   android:layout_width="@dimen/_35sdp"
                   android:layout_height="@dimen/_35sdp"
                   android:src="@drawable/user_default"
                   android:layout_centerVertical="true"
                   />

               <LinearLayout
                   android:layout_toStartOf="@+id/llEnd"
                   android:layout_toEndOf="@+id/ivUserImg"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="vertical"
                   android:layout_centerVertical="true"
                   android:layout_marginStart="@dimen/_10sdp"
                   android:layout_marginEnd="@dimen/_10sdp">

                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_centerInParent="true"
                       android:text="@string/welcome"
                       android:fontFamily="@font/poppins_regular"
                       android:textSize="@dimen/_10sdp"
                       android:textColor="@color/white"
                       android:alpha=".4"
                       />


                   <TextView
                       android:id="@+id/tvName"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_centerInParent="true"
                       android:text="Omar Stanton"
                       android:fontFamily="@font/poppins_medium"
                       android:textSize="@dimen/_12sdp"
                       android:layout_marginTop="-2dp"
                       android:textColor="@color/white"
                       />

               </LinearLayout>


               <LinearLayout
                   android:id="@+id/llEnd"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:orientation="horizontal"
                   android:layout_alignParentEnd="true"
                   android:layout_centerInParent="true"
                   >

                   <ImageView
                       android:id="@+id/ivMsg"
                       android:layout_width="@dimen/_20sdp"
                       android:layout_height="@dimen/_20sdp"
                       android:src="@drawable/ic_customer_service"
                       app:tint="@color/white"
                       android:visibility="gone"/>

                   <ImageView
                       android:id="@+id/ivNotification"
                       android:layout_width="@dimen/_20sdp"
                       android:layout_height="@dimen/_20sdp"
                       android:src="@drawable/ic_white_notification"
                       android:layout_marginStart="@dimen/_15sdp"/>

               </LinearLayout>


           </RelativeLayout>




           <androidx.cardview.widget.CardView
               android:id="@+id/searchBar"
               android:layout_below="@+id/ivHeader"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               app:cardCornerRadius="@dimen/_13sdp"
               android:layout_marginStart="@dimen/_20sdp"
               android:layout_marginTop="-20dp"
               android:layout_marginEnd="@dimen/_20sdp"
               app:cardElevation="@dimen/_5sdp">


               <RelativeLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:padding="@dimen/_10sdp">

                   <ImageView
                       android:id="@+id/ivSearch"
                       android:layout_width="@dimen/_15sdp"
                       android:layout_height="@dimen/_15sdp"
                       android:src="@drawable/ic_search"/>


                   <TextView
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_toEndOf="@+id/ivSearch"
                       android:layout_toStartOf="@+id/ivFilter"
                       android:text="@string/search"
                       android:fontFamily="@font/poppins_regular"
                       android:textSize="@dimen/_12sdp"
                       android:layout_marginStart="@dimen/_10sdp"
                       android:textColor="@color/black_light"/>


                   <ImageView
                       android:id="@+id/ivFilter"
                       android:layout_width="@dimen/_15sdp"
                       android:layout_height="@dimen/_15sdp"
                       android:src="@drawable/ic_filter"
                       android:layout_alignParentEnd="true"
                       android:layout_centerInParent="true"
                       android:visibility="gone"/>


               </RelativeLayout>


           </androidx.cardview.widget.CardView>

           <androidx.recyclerview.widget.RecyclerView
               android:id="@+id/rvStory"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_below="@+id/searchBar"
               android:layout_margin="@dimen/_10sdp"
               android:orientation="horizontal"
               tools:listitem="@layout/item_story"
               app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

           <TextView
               android:id="@+id/tvRecentSearch"
               android:layout_below="@+id/rvStory"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:textColor="@color/color_black_light"
               android:textSize="@dimen/_14sdp"
               android:fontFamily="@font/poppins_bold"
               android:text="@string/recent_searches"
               android:layout_marginStart="@dimen/_18sdp"
               />


           <androidx.recyclerview.widget.RecyclerView
               android:id="@+id/rvRecentSearch"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_below="@+id/tvRecentSearch"
               android:layout_marginStart="@dimen/_12sdp"
               android:layout_marginTop="@dimen/_10sdp"
               android:orientation="horizontal"
               app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
               tools:listitem="@layout/item_search" />

           <TextView
               android:id="@+id/tvPopularHome"
               android:layout_below="@+id/rvRecentSearch"
               android:layout_width="wrap_content"
               android:layout_marginTop="@dimen/_15sdp"
               android:layout_height="wrap_content"
               android:textColor="@color/color_black_light"
               android:textSize="@dimen/_14sdp"
               android:fontFamily="@font/poppins_bold"
               android:text="@string/most_popular_home"
               android:layout_marginStart="@dimen/_18sdp"
               />

           <androidx.recyclerview.widget.RecyclerView
               android:id="@+id/rvPopularHome"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_below="@+id/tvPopularHome"
               android:layout_marginStart="@dimen/_12sdp"
               android:layout_marginTop="@dimen/_10sdp"
               android:orientation="horizontal"
               app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
               tools:listitem="@layout/item_popular_home" />



       </RelativeLayout>


   </androidx.core.widget.NestedScrollView>

</layout>
