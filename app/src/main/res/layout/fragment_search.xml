<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/white">

            <androidx.cardview.widget.CardView
                android:id="@+id/searchBar"
                android:layout_below="@+id/ivHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/_13sdp"
                android:layout_margin="@dimen/_20sdp"
                app:cardElevation="@dimen/_5sdp">


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_10sdp">

                    <ImageView
                        android:id="@+id/ivSearch"
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:src="@drawable/ic_search"/>


                    <EditText
                        android:id="@+id/edSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/ivSearch"
                        android:layout_toStartOf="@+id/ivFilter"
                        android:hint="@string/search"
                        android:fontFamily="@font/poppins_regular"
                        android:textSize="@dimen/_12sdp"
                        android:background="@null"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:textColor="@color/black_light"/>


                    <ImageView
                        android:id="@+id/ivFilter"
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:src="@drawable/ic_filter"
                        android:layout_alignParentEnd="true"
                        android:layout_centerInParent="true"/>


                </RelativeLayout>


            </androidx.cardview.widget.CardView>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivNearby"
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:src="@drawable/ic_nearby"/>

                    <TextView
                        android:layout_toEndOf="@+id/ivNearby"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_gray_light3"
                        android:textSize="@dimen/_13sdp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/nearby"
                        android:layout_marginStart="@dimen/_8sdp"
                        />




                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp">


                    <EditText
                        android:padding="@dimen/_5sdp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_gray_light3"
                        android:textSize="@dimen/_12sdp"
                        android:fontFamily="@font/poppins_bold"
                        android:hint="@string/recent_searches"
                        android:background="@null"

                        />


                    <TextView
                        android:id="@+id/tvClear"
                        android:padding="@dimen/_5sdp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_gray_light3"
                        android:textSize="@dimen/_12sdp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/clear"
                        android:layout_alignParentEnd="true"
                        android:layout_centerInParent="true"
                        />




                </RelativeLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_gray_line"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp">

                    <ImageView
                        android:id="@+id/ivPin"
                        android:layout_width="@dimen/_17sdp"
                        android:layout_height="@dimen/_17sdp"
                        android:src="@drawable/ic_pin"/>

                    <TextView
                        android:layout_toEndOf="@+id/ivPin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_gray_light3"
                        android:textSize="@dimen/_13sdp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Indore"
                        android:layout_marginStart="@dimen/_8sdp"
                        />




                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:background="@color/color_gray_line"/>


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp">

                    <ImageView
                        android:id="@+id/ivSearch11"
                        android:layout_width="@dimen/_17sdp"
                        android:layout_height="@dimen/_17sdp"
                        android:src="@drawable/ic_search"/>

                    <TextView
                        android:layout_toEndOf="@+id/ivSearch11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_gray_light3"
                        android:textSize="@dimen/_13sdp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/nearby"
                        android:layout_marginStart="@dimen/_8sdp"
                        />




                </RelativeLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:background="@color/color_gray_line"/>


            </LinearLayout>



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_black_light"
                android:textSize="@dimen/_14sdp"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/trending_destinations"
                android:layout_marginStart="@dimen/_18sdp"
                android:visibility="gone"
                />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTrendingDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_10sdp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                tools:listitem="@layout/item_trending_destination"
                app:spanCount="2"
                android:visibility="gone"
                />


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_bookmark"
                    android:visibility="visible"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    />


                <TextView
                    android:id="@+id/tvNotFound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_black_light"
                    android:textSize="@dimen/_14sdp"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/data_not_available"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:visibility="gone"
                    />

            </RelativeLayout>
            
            


        </LinearLayout>


    </androidx.core.widget.NestedScrollView>

</layout>
